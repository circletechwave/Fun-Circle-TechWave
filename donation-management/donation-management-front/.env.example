# Supabase設定
# ⚠️ 必須: Supabaseプロジェクトの設定値を入力してください
# Supabase Dashboardの Settings > API から取得できます
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudflare Pages環境変数（デプロイ時に自動設定）
# CF_PAGES=1
# CF_PAGES_COMMIT_SHA=
# CF_PAGES_BRANCH=
# CF_PAGES_URL=

# アプリケーション設定
VITE_APP_NAME="社内寄贈物管理システム"
VITE_APP_DESCRIPTION="社内に寄贈された書籍・備品を効率的に管理"

# 開発環境設定
VITE_API_BASE_URL=http://localhost:8787
VITE_ENABLE_DEBUG=false

# 開発用ログイン認証情報（オプション）
# 開発環境のみで使用される認証情報です
# 本番環境では使用されません（import.meta.env.DEVで制御）
VITE_DEV_EMAIL=admin@company.com
VITE_DEV_PASSWORD=password